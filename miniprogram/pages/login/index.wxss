/* 页面使用 app.wxss 中的统一样式。 */
.quick-login{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:28rpx;padding:24rpx}
.quick-title{font-size:25rpx;font-weight:550;color:#536d46}
