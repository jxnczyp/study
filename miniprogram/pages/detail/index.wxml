<view class="page">
  <view wx:if="{{loading}}" class="loading">正在加载…</view>
  <view wx:elif="{{error}}" class="error">{{error}}<button class="secondary retry" bindtap="refresh">重新加载</button></view>
  <block wx:elif="{{question}}">
    <view class="row start"><text class="tag">{{question.subject}}</text><text class="subtitle">{{question.topic}} · {{question.difficulty}}</text></view>
    <view class="subtitle" style="margin-top:18rpx">{{question.grade || '未分类'}} · {{question.question_type || '未分类'}}</view>
    <view class="heading">{{question.title}}</view>
    <view wx:if="{{question.image_id}}" class="original-photo">
      <view class="label">题目原图</view>
      <image wx:if="{{imagePath}}" class="photo-preview" src="{{imagePath}}" mode="aspectFit" bindtap="previewPhoto"/>
      <button wx:elif="{{imageLoading}}" class="secondary" loading="{{imageLoading}}" disabled="{{imageLoading}}">正在加载题目原图…</button>
      <button wx:else class="secondary" bindtap="loadPhoto">{{imageError || '加载题目原图'}}</button>
      <view class="photo-tip">点击图片查看大图</view>
      <button wx:if="{{question.source_image_id}}" class="ghost" bindtap="viewFullPage">查看完整作业原图 →</button>
    </view>
    <view class="question-text">{{question.content}}</view>
    <view wx:for="{{question.options}}" wx:key="index" class="option"><text class="option-letter">{{index + 1}}</text>{{item}}</view>
    <view wx:if="{{question.student_answer}}" class="answer-box"><view class="answer-label">学生作答（收录时）</view><view class="answer-text">{{question.student_answer}}</view></view>
    <view wx:if="{{question.assessment_source === 'vision'}}" class="tip">本题由视觉模型辅助检查后经用户确认收录。参考答案经过用户核对，不是官方标准答案。<view>{{question.judgment_reason}}</view></view>
    <view class="answer-box">
      <view class="answer-label">✓ 正确答案</view><view class="answer-text">{{question.answer}}</view>
      <view class="answer-label" style="margin-top:28rpx">解题思路</view><view class="answer-text">{{question.explanation || '暂未添加解析，复习时记得回顾相关知识点。'}}</view>
    </view>
    <view class="row start" style="margin-bottom:35rpx"><text class="subtitle">出错原因</text><text class="tag orange">{{question.reason}}</text><text class="status {{question.mastered ? 'done' : ''}}">{{question.mastered ? '已掌握' : '待巩固'}}</text></view>
    <view class="actions"><button class="primary" bindtap="review">再练一次</button><button class="secondary" loading="{{busy}}" disabled="{{busy}}" bindtap="toggleMastered">{{question.mastered ? '设为待巩固' : '标记已掌握'}}</button></view>
    <button wx:if="{{loggedIn}}" class="danger submit" disabled="{{busy}}" bindtap="remove">删除错题</button>
  </block>
</view>
