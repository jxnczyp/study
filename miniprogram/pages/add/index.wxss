/* 页面使用 app.wxss 中的统一样式。 */
.sheet-card{margin-top:28rpx}
.assessment-card.chosen{border-color:#91ad76;box-shadow:0 0 0 2rpx #dce9d0}
.judgment{font-size:22rpx;padding:7rpx 16rpx;border-radius:9rpx;background:#f6eddd;color:#b4935f}
.judgment.correct{background:#eef3e5;color:#82986c}
.judgment.incorrect{background:#f9e9de;color:#ba7e5c}
.classification-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}
.batch-bar{padding:25rpx 0 15rpx}
.input+.input{margin-top:14rpx}
.divider{display:flex;align-items:center;gap:18rpx;margin:40rpx 0 30rpx}
.divider-line{flex:1;height:1rpx;background:#e2e7d6}
.divider-text{font-size:22rpx;color:#9aa48c;white-space:nowrap}
