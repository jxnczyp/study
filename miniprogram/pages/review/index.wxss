.assessment-card.chosen{border-color:#91ad76;box-shadow:0 0 0 2rpx #dce9d0}.judgment{font-size:22rpx;padding:7rpx 16rpx;border-radius:9rpx;background:#f6eddd;color:#b4935f}.judgment.correct{background:#eef3e5;color:#82986c}.judgment.incorrect{background:#f9e9de;color:#ba7e5c}.classification-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.batch-bar{padding:25rpx 0 15rpx}.input+.input{margin-top:14rpx}
