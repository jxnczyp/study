<view class="page"><block wx:if="question &amp;&amp; !finished"><view class="eyebrow">{{mode}}</view><view class="row"><view class="heading" style="font-size:36rpx">{{question.subject}} · 多掌握一点</view><text class="subtitle">{{index + 1}} / {{total}}</text></view><view class="progress-track"><view class="progress-fill" style="width:{{progress}}%"/></view><view class="subtitle" style="margin-top:30rpx">{{question.topic}} · {{question.difficulty}}</view><button wx:if="question.image_id" class="ghost" bindtap="viewPhoto" loading="{{imageLoading}}" disabled="{{imageLoading}}">▧ 查看题目原图</button><view class="question-text">{{question.content}}</view><block wx:if="options.length"><view wx:for="options" wx:key="index" data-index="{{index}}" bindtap="choose" class="option {{item.selected ? 'selected' : ''}} {{item.correct ? 'correct' : ''}} {{item.incorrect ? 'incorrect' : ''}}"><text class="option-letter">{{item.letter}}</text><text>{{item.value}}</text></view></block><block wx:else><view class="label">你的答案</view><input class="input" placeholder="先独立思考，再提交答案" placeholder-class="placeholder" value="{{answer}}" disabled="{{submitted || busy}}" bindinput="input" bindconfirm="submit" maxlength="1000"/></block><view wx:if="referenceVisible &amp;&amp; !submitted" class="answer-box"><view class="answer-label">对照参考答案自评（不按文字完全相同比较）</view><view class="answer-text">{{question.answer}}</view><view class="answer-text">{{question.explanation}}</view><view class="photo-tip">开放题和模型参考答案请自行核对；仍有疑问时先记录为需巩固。</view><view class="actions"><button class="primary" data-correct="yes" bindtap="selfGrade" disabled="{{busy}}">已核对，答对</button><button class="secondary" data-correct="no" bindtap="selfGrade" disabled="{{busy}}">需要巩固</button></view></view><block wx:if="submitted"><view class="feedback {{result.correct ? '' : 'wrong'}}"><view class="feedback-title">{{result.correct ? '答对了，继续保持！' : '没关系，弄懂就是进步。'}}</view><view>正确答案：{{result.answer}}</view><view class="answer-text">{{result.explanation || '回顾相关知识点，再独立尝试一次。'}}</view></view><button class="primary submit" bindtap="next">{{index + 1 === total ? '查看练习成果' : '下一题'}} →</button></block><button wx:elif="!referenceVisible" class="primary submit" loading="{{busy}}" disabled="{{busy || !answer}}" bindtap="submit">提交答案 →</button><view wx:if="!loggedIn" class="footnote">体验模式 · 登录后可保存学习记录</view></block><view wx:elif="finished" class="result"><view class="result-symbol">✓</view><view class="eyebrow">A STEP FORWARD</view><view class="heading">又向前走了一步！</view><view class="subtitle">完成 {{total}} 道练习，每次思考都有意义。</view><view class="result-stats"><view><view class="result-number">{{correctCount}}</view><view class="result-label">答对题目</view></view><view><view class="result-number">{{accuracy}}%</view><view class="result-label">本次正确率</view></view></view><view wx:if="!loggedIn" class="tip">本次为体验练习，未保存到学习记录。登录后可保存后续练习。</view><button class="primary submit" bindtap="close">完成练习，继续进步 →</button><button wx:if="!loggedIn" class="ghost submit" bindtap="login">登录我的学习空间</button></view></view>
